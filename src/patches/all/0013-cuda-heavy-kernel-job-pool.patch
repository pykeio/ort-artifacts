--- a/cmake/onnxruntime_providers_cuda.cmake
+++ b/cmake/onnxruntime_providers_cuda.cmake
@@ -609,6 +609,23 @@
     endif()
   endif()
 
+  # The CUTLASS warp-specialized MoE translation units each need several gigabytes of
+  # resident memory in cicc, so a wide parallel build can exhaust a small machine long
+  # before it runs out of cores. Route them through a Ninja job pool that caps how many
+  # run at once, leaving the remaining build slots free for ordinary translation units.
+  if(onnxruntime_CUDA_HEAVY_COMPILE_JOBS)
+    set_property(GLOBAL APPEND PROPERTY JOB_POOLS
+                 ort_cuda_heavy=${onnxruntime_CUDA_HEAVY_COMPILE_JOBS})
+    foreach(_ort_heavy_target
+            onnxruntime_providers_cuda_sm90_tma
+            onnxruntime_providers_cuda_sm120_tma
+            onnxruntime_providers_cuda_flash_attention)
+      if(TARGET ${_ort_heavy_target})
+        set_target_properties(${_ort_heavy_target} PROPERTIES JOB_POOL_COMPILE ort_cuda_heavy)
+      endif()
+    endforeach()
+  endif()
+
   # Cannot use glob because the file cuda_provider_options.h should not be exposed out.
   set(ONNXRUNTIME_CUDA_PROVIDER_PUBLIC_HEADERS
         "${REPO_ROOT}/include/onnxruntime/core/providers/cuda/cuda_context.h"
